<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- Remote GitHub -->
    <remote name="sky-remote" fetch="https://github.com" />

    <!-- 1. Permanent Fix: Remove Unused Google Virtual Emulators -->
    <remove-project name="device/google/cuttlefish" />
    <remove-project name="device/google/cuttlefish_vmm" />
    <remove-project name="device/google/trout" />

    <!-- 2. Device Tree (Android 17) -->
    <project name="Yadu72485/device_xiaomi_sky-" 
             path="device/xiaomi/sky" 
             remote="sky-remote" 
             revision="17" />

    <!-- 3. Kernel Trees (Android 17) -->
    <project name="Yadu72485/kernel_xiaomi_sky" 
             path="kernel/xiaomi/sky" 
             remote="sky-remote" 
             revision="17" />
    <project name="Yadu72485/kernel_xiaomi_sm8450-modules" 
             path="kernel/xiaomi/sm8450-modules" 
             remote="sky-remote" 
             revision="17" />

    <!-- 4. Vendor Tree -->
    <project name="Yadu72485/vendor_xiaomi_sky" 
             path="vendor/xiaomi/sky" 
             remote="sky-remote" 
             revision="16" />

    <!-- 5. Leica Camera Vendor (Android 17) -->
    <project name="Yadu72485/vendor_xiaomi_miuicamera-sky" 
             path="vendor/xiaomi/miuicamera-sky" 
             remote="sky-remote" 
             revision="17" />

    <!-- 6. Xiaomi Hardware Tree (Lineage 24.0 Base) -->
    <project name="Yadu72485/android_hardware_xiaomi" 
             path="hardware/xiaomi" 
             remote="sky-remote" 
             revision="lineage-24.0" />

    <!-- 7. Permanent Fix: Lineage Compat (Lineage 24.0 Base) -->
    <remove-project name="LineageOS/android_hardware_lineage_compat" />
    <project name="Yadu72485/android_hardware_lineage_compat"
             path="hardware/lineage/compat"
             remote="sky-remote"
             revision="lineage-24.0" />

    <!-- 8. Permanent Fix: ContactsProvider (Lineage 24.0 Base) -->
    <remove-project name="LineageOS/android_packages_providers_ContactsProvider" />
    <project name="Yadu72485/android_packages_providers_ContactsProvider"
             path="packages/providers/ContactsProvider"
             remote="sky-remote"
             revision="lineage-24.0" />
</manifest>
